# ══════════════════════════════════════════
# COMMS HUB — ENV VARS
# Copy file này thành .env.local và điền giá trị
# ══════════════════════════════════════════

# ── BACKEND API ───────────────────────────
# Comms Hub backend (Node + Express + Postgres trên MCP Garena)
VITE_API_BASE_URL=http://localhost:4000/api

# ── AUTH ──────────────────────────────────
# Garena SSO (điền sau khi có docs từ IT)
VITE_GARENA_SSO_URL=
VITE_GARENA_SSO_CLIENT_ID=
# Để trống = dùng mock auth (email lookup qua backend /api/auth/login)
